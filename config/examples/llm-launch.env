# Example of runtime/llm-launch.env, the launch file of the text runtime (docs/configuration.md, Launch files).
# The backend writes the real file into the data volume from the model settings. This copy is a reference only and
# nothing reads it: the values are the defaults of the default profile on the target tier.
# The entrypoint reads KEY=VALUE lines as data and never sources the file.
MODEL_PROFILE=gemma-4-26b-a4b
MODEL_FILE=gemma-4-26B_q4_0-it.gguf
CONTEXT_SIZE=16384
GPU_LAYERS=-1
BATCH_SIZE=512
MOE_CPU_LAYERS=0
USE_MMAP=0
KV_QUANT=f16
SWA_PADDING=0
SMART_CACHE=0
LEVEL=A
