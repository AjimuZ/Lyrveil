# Text is stored and checked out with LF, because files copied into Linux images
# fail with "bad interpreter" when a Windows checkout adds CRLF. Windows entry
# points are the exception: cmd.exe and PowerShell 5.1 expect CRLF.
* text=auto eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.psm1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
