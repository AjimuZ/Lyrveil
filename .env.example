# Deployment settings of Lyrveil, described in docs/configuration.md.
# setup.cmd copies this file to .env, limits .env to the current Windows user and fills the
# generated values. It never overwrites an existing .env. Never commit a real .env.

# Address and port of the only published port. LAN exposure is unsupported.
LYRVEIL_BIND_ADDRESS=127.0.0.1
LYRVEIL_HTTP_PORT=4200

# Windows folder for exported backups; empty means %USERPROFILE%\Documents\Lyrveil\backups.
# Read by the scripts only.
LYRVEIL_BACKUP_DIR=

# Bearer token of the control API: 64 hexadecimal characters written by setup.cmd.
# The backend refuses this placeholder.
LYRVEIL_CONTROL_TOKEN=generated-by-setup

# Time zone of time context and scheduling.
LYRVEIL_TZ=Europe/Rome

# DEBUG, INFO, WARNING or ERROR.
LYRVEIL_LOG_LEVEL=INFO

# Turns the memory failure in preflight into a warning. Unsupported.
LYRVEIL_ALLOW_LOW_MEMORY=false

# Set by setup.cmd after the user accepts the model licences.
LYRVEIL_MODEL_LICENSES_ACCEPTED=false
